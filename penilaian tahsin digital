      <thead class="bg-gray-100">
       <tr>
        <th class="px-3 py-2 text-left">Nama</th>
        <th class="px-3 py-2">Surat</th>
        <th class="px-3 py-2">Nilai</th>
        <th class="px-3 py-2"></th>
       </tr>
      </thead>
      <tbody id="tbody-hafalan"></tbody>
     </table>
    </div>
