      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="kh-status">Status</label> <select id="kh-status" class="w-full border rounded-lg px-3 py-2 text-sm"> <option value="Hadir">Hadir</option><option value="Sakit">Sakit</option><option value="Izin">Izin</option><option value="Alfa">Alfa</option> </select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1 flex items-center gap-2"><input type="checkbox" id="kh-ekstra"> Ekstra</label>
      </div>
     </div><button type="submit" data-template-id="btn-simpan-kh" class="canva-button px-5 py-2 rounded-lg text-sm font-medium"></button> <span id="kh-loading" class="hidden ml-2 text-gray-500 text-sm">Menyimpan...</span>
     <div id="kh-error" class="hidden text-red-600 text-sm mt-1"></div>
    </form>
    <div class="overflow-x-auto">
     <table id="tbl-kehadiran" class="w-full text-sm hidden">
      <thead class="bg-gray-100">
       <tr>
        <th class="px-3 py-2 text-left">Nama</th>
        <th class="px-3 py-2">Tanggal</th>
        <th class="px-3 py-2">Status</th>
        <th class="px-3 py-2">Ekstra</th>
        <th class="px-3 py-2"></th>
       </tr>
      </thead>
      <tbody id="tbody-kehadiran"></tbody>
     </table>
    </div>
    <p id="empty-kehadiran" data-template-id="empty-kehadiran" class="canva-text text-center py-6"></p>
   </section><!-- HAFALAN -->
   <section id="tab-hafalan" class="space-y-6 hidden">
    <form id="form-hafalan" class="p-5 rounded-xl border space-y-4" data-template-id="form-hafalan">
     <h2 data-template-id="form-hafalan-title" class="canva-text font-bold mb-2"></h2>
     <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
       <label class="block text-sm font-medium mb-1" for="hf-nama">Nama</label><input id="hf-nama" type="text" required class="w-full border rounded-lg px-3 py-2 text-sm">
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="hf-surat">Surat</label> <select id="hf-surat" class="w-full border rounded-lg px-3 py-2 text-sm"> <option>Al Muthaffifin</option><option>Al Infithar</option><option>At Takwiir</option><option>'Abasa</option><option>An Nazi'at</option><option>An Naba'</option> </select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="hf-nilai">Nilai</label><input id="hf-nilai" type="number" min="0" max="100" class="w-full border rounded-lg px-3 py-2 text-sm">
      </div>
     </div><button type="submit" data-template-id="btn-simpan-hf" class="canva-button px-5 py-2 rounded-lg text-sm font-medium"></button> <span id="hf-loading" class="hidden ml-2 text-gray-500 text-sm">Menyimpan...</span>
     <div id="hf-error" class="hidden text-red-600 text-sm mt-1"></div>
    </form>
    <div class="overflow-x-auto">
