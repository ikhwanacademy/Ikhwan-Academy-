  </main><!-- Delete confirm modal -->
  <div id="confirm-modal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
   <div class="bg-white rounded-xl p-6 max-w-sm w-full space-y-4">
    <p id="confirm-text" class="font-medium text-sm"></p>
    <div class="flex gap-3 justify-end"><button id="cancel-del" class="px-4 py-2 rounded-lg border text-sm">Batal</button> <button id="confirm-del" class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm">Hapus</button>
    </div>
   </div>
  </div>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <script>
    let allData = [];
    let pendingDelete = null;

    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => { b.classList.remove('tab-active'); b.classList.add('tab-inactive'); });
        btn.classList.add('tab-active'); btn.classList.remove('tab-inactive');
        ['kehadiran','hafalan','penilaian'].forEach(t => {
          document.getElementById('tab-'+t).classList.toggle('hidden', t !== btn.dataset.tab);
        });
      });
    });

    const handler = {
      onDataChanged(data) {
        allData = data;
        renderAll(data);
      }
    };

    function renderAll(data) {
      const kh = data.filter(d => d.tipe === 'kehadiran');
      const hf = data.filter(d => d.tipe === 'hafalan');
      const pn = data.filter(d => d.tipe === 'penilaian');
      renderTable('kehadiran', kh, ['nama_santri','tanggal','status_kehadiran','ekstra_kehadiran']);
      renderTable('hafalan', hf, ['nama_santri','surat_hafalan','nilai_hafalan']);
      renderTable('penilaian', pn, ['nama_santri','kedisiplinan','aktifitas','inisiatif','ketelitian','kepatuhan','kelancaran','makhroj','tajwid','menulis','ekstra_penilaian','catatan_guru']);
    }

    function renderTable(type, data, cols) {
      const tbody = document.getElementById('tbody-'+type);
      const tbl = document.getElementById('tbl-'+type);
      const empty = document.getElementById('empty-'+type);
      if (!data.length) { tbl.classList.add('hidden'); empty.classList.remove('hidden'); return; }
      tbl.classList.remove('hidden'); empty.classList.add('hidden');
      tbody.innerHTML = '';
      data.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'border-b';
        let html = '';
        cols.forEach(c => {
          let v = item[c];
          if (typeof v === 'boolean') v = v ? '✓' : '✗';
          html += `<td class="px-3 py-2 ${c==='nama_santri'?'text-left':'text-center'}">${esc(v ?? '')}</td>`;
        });
        html += `<td class="px-3 py-2 text-center"><button class="text-red-500 hover:text-red-700 del-btn text-xs" title="Hapus">✕</button></td>`;
        tr.innerHTML = html;
        tr.querySelector('.del-btn').onclick = () => confirmDel(item);
        tbody.appendChild(tr);
      });
    }

    function esc(s) { const d=document.createElement('div'); d.textContent=String(s); return d.innerHTML; }

    function confirmDel(item) {
      pendingDelete = item;
      document.getElementById('confirm-text').textContent = `Hapus data ${item.nama_santri}?`;
      document.getElementById('confirm-modal').classList.remove('hidden');
    }
    document.getElementById('cancel-del').onclick = () => { document.getElementById('confirm-modal').classList.add('hidden'); pendingDelete=null; };
    document.getElementById('confirm-del').onclick = async () => {
      if(!pendingDelete) return;
      const btn=document.getElementById('confirm-del'); btn.disabled=true; btn.textContent='...';
      await window.dataSdk.delete(pendingDelete);
      btn.disabled=false; btn.textContent='Hapus';
      document.getElementById('confirm-modal').classList.add('hidden'); pendingDelete=null;
    };

    // Form handlers
    async function submitForm(formId, getData, loadingId, errorId) {
      const form = document.getElementById(formId);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errEl = document.getElementById(errorId);
        errEl.classList.add('hidden');
        if (allData.length >= 999) { errEl.textContent='Batas 999 data tercapai.'; errEl.classList.remove('hidden'); return; }
        const btn = form.querySelector('button[type="submit"]');
        const ld = document.getElementById(loadingId);
        btn.disabled=true; ld.classList.remove('hidden');
        const result = await window.dataSdk.create(getData());
        btn.disabled=false; ld.classList.add('hidden');
        if(result.isOk) form.reset(); else { errEl.textContent='Gagal menyimpan.'; errEl.classList.remove('hidden'); }
      });
    }

    submitForm('form-kehadiran', () => ({
      tipe:'kehadiran', nama_santri: document.getElementById('kh-nama').value,
      tanggal: document.getElementById('kh-tanggal').value,
      status_kehadiran: document.getElementById('kh-status').value,
      ekstra_kehadiran: document.getElementById('kh-ekstra').checked
    }), 'kh-loading', 'kh-error');

    submitForm('form-hafalan', () => ({
      tipe:'hafalan', nama_santri: document.getElementById('hf-nama').value,
      surat_hafalan: document.getElementById('hf-surat').value,
      nilai_hafalan: Number(document.getElementById('hf-nilai').value) || 0
    }), 'hf-loading', 'hf-error');

    submitForm('form-penilaian', () => ({
      tipe:'penilaian', nama_santri: document.getElementById('pn-nama').value,
      kedisiplinan: document.getElementById('pn-kedisiplinan').value,
      aktifitas: document.getElementById('pn-aktifitas').value,
      inisiatif: document.getElementById('pn-inisiatif').value,
      ketelitian: document.getElementById('pn-ketelitian').value,
      kepatuhan: document.getElementById('pn-kepatuhan').value,
      kelancaran: document.getElementById('pn-kelancaran').value,
      makhroj: document.getElementById('pn-makhroj').value,
      tajwid: document.getElementById('pn-tajwid').value,
      menulis: document.getElementById('pn-menulis').value,
      ekstra_penilaian: document.getElementById('pn-ekstra').value,
      catatan_guru: document.getElementById('pn-catatan').value
    }), 'pn-loading', 'pn-error');

    (async () => {
      const r = await window.dataSdk.init(handler);
      if(!r.isOk) { document.getElementById('kh-error').textContent='Gagal memuat data.'; document.getElementById('kh-error').classList.remove('hidden'); }
    })();
  </script>
