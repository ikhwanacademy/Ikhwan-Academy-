   </section><!-- PENILAIAN -->
   <section id="tab-penilaian" class="space-y-6 hidden">
    <form id="form-penilaian" class="p-5 rounded-xl border space-y-4" data-template-id="form-penilaian">
     <h2 data-template-id="form-penilaian-title" class="canva-text font-bold mb-2"></h2>
     <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-nama">Nama</label><input id="pn-nama" type="text" required class="w-full border rounded-lg px-3 py-2 text-sm">
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-kedisiplinan">Kedisiplinan</label><select id="pn-kedisiplinan" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-aktifitas">Aktifitas</label><select id="pn-aktifitas" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-inisiatif">Inisiatif</label><select id="pn-inisiatif" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-ketelitian">Ketelitian</label><select id="pn-ketelitian" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-kepatuhan">Kepatuhan</label><select id="pn-kepatuhan" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-kelancaran">Kelancaran</label><select id="pn-kelancaran" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-makhroj">Makhroj</label><select id="pn-makhroj" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-tajwid">Tajwid</label><select id="pn-tajwid" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-menulis">Menulis</label><select id="pn-menulis" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div>
       <label class="block text-sm font-medium mb-1" for="pn-ekstra">Ekstra</label><select id="pn-ekstra" class="w-full border rounded-lg px-3 py-2 text-sm"><option>Baik</option><option>Cukup</option><option>Kurang</option></select>
      </div>
      <div class="md:col-span-2">
       <label class="block text-sm font-medium mb-1" for="pn-catatan">Catatan Guru</label><textarea id="pn-catatan" rows="2" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea>
      </div>
     </div><button type="submit" data-template-id="btn-simpan-pn" class="canva-button px-5 py-2 rounded-lg text-sm font-medium"></button> <span id="pn-loading" class="hidden ml-2 text-gray-500 text-sm">Menyimpan...</span>
     <div id="pn-error" class="hidden text-red-600 text-sm mt-1"></div>
    </form>
    <div class="overflow-x-auto">
     <table id="tbl-penilaian" class="w-full text-sm hidden">
      <thead class="bg-gray-100">
       <tr>
        <th class="px-3 py-2 text-left">Nama</th>
        <th class="px-3 py-2">Kedisiplinan</th>
        <th class="px-3 py-2">Aktifitas</th>
        <th class="px-3 py-2">Inisiatif</th>
        <th class="px-3 py-2">Ketelitian</th>
        <th class="px-3 py-2">Kepatuhan</th>
        <th class="px-3 py-2">Kelancaran</th>
        <th class="px-3 py-2">Makhroj</th>
        <th class="px-3 py-2">Tajwid</th>
        <th class="px-3 py-2">Menulis</th>
        <th class="px-3 py-2">Ekstra</th>
